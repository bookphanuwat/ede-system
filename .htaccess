RewriteEngine On
#RewriteBase /

Options +FollowSymLinks +MultiViews

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# if external access force https
RewriteCond %{HTTP_HOST} ^ath7.link [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# เปลี่ยนจาก ede-system/user เป็น ede-system/pages/user-page.php
RewriteRule ^user$ pages/user-page.php [L,NC,QSA]

# หากต้องการให้รองรับการส่ง ID เช่น ede-system/user/2
RewriteRule ^user/([0-9]+)$ pages/user-page.php?id=$1 [L,NC,QSA]

# Routing Rule
RewriteRule ^([0-9a-z-]+)/?$ index.php?dev=$1 [QSA]

<IfModule mod_headers.c>
  Header set X-UA-Compatible "IE=Edge,chrome=1"
  
  # ป้องกัน Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # CSP จัดการใน PHP (index.php) แล้ว หรือถ้าจะใส่ในนี้ต้องระวังเรื่อง nonce
  # Header set Content-Security-Policy "frame-ancestors 'self';" 
  
  <FilesMatch "\.(appcache|crx|css|eot|gif|htc|ico|jpe?g|js|m4a|m4v|manifest|mp4|oex|oga|ogg|ogv|otf|pdf|png|safariextz|svg|svgz|ttf|vcf|webm|webp|woff|xml|xpi)$">
    Header unset X-UA-Compatible
  </FilesMatch>
</IfModule>